indexsearch()
{
read -r -p "Book Chapter Verse-(s): " bookinput chapterinput verseinput
b="${bookinput:+\$1==\"${indexmap[$((bookinput-1))]}}\""
c="${chapterinput:+\$2==${chapterinput}}"
c=${c:=1}

if [[ -z $verseinput ]];then
  v=1
elif [[ $verseinput =~ .*-.* ]];then
  v="\$3>=${verseinput%%-*} && \$3<=${verseinput##*-}"
elif [[ $verseinput =~ [0-9]+ ]]; then
  v="\$3==$verseinput"
fi

if [[ -n $bookinput ]];then
  awklineoutput=($(awk "$b && $c && $v {print NR}" $awkindex))
else
  printf "%s\n" else?
fi
echo ${#awklineoutput[@]} ${awklineoutput[0]},${awklineoutput[-1]} ${indexmap[$((bookinput-1))]} $b $c $v


sed -n "${awklineoutput[0]},${awklineoutput[-1]}p" "$BOOKDIRECTORY"
}

